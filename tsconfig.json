{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "allowJs": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "index.js", "app.js", "server.js"],
  "exclude": [
    "node_modules",
    "dist",
    "tests/**/*",
    "jest.config.js",
    "jest.setup.js"
  ]
}
